{
  "name": "my-own-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "test -f .certs/dev.key || ./scripts/gen-cert.sh; HTTPS=1 vite --host",
    "cert": "./scripts/gen-cert.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "android": "vite build && cap sync android && cd android && JAVA_HOME=${JAVA_HOME:-$HOME/.local/jdk} ANDROID_HOME=${ANDROID_HOME:-$HOME/.local/android-sdk} ./gradlew assembleDebug -q",
    "tauri": "tauri",
    "test": "vitest run",
    "espeak": "node scripts/build-espeak.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@mozilla/readability": "^0.6.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-http": "^2.8.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.2",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.3",
    "katex": "^0.19.0",
    "onnxruntime-web": "^1.30.0",
    "pdfjs-dist": "^6.4.299",
    "phonemizer": "^1.2.1",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@echogarden/espeak-ng-emscripten": "0.3.5",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.1",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "license": "GPL-3.0-or-later",
  "description": "A private AI assistant that runs on your own device: in the browser, on Android and on Windows."
}
